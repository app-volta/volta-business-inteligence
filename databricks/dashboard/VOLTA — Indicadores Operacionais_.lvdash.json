{
  "datasets": [
    {
      "name": "6407fc6d",
      "displayName": "ds_1908_kpis_operacionais",
      "queryLines": [
        "WITH occurrence_kpi AS (\r\n",
        "    SELECT\r\n",
        "        COUNT(DISTINCT incident_id) AS total_occurrences,\r\n",
        "        COALESCE(SUM(estimated_quantity_kg), 0) AS total_estimated_quantity_kg\r\n",
        "    FROM volta_postgres.bi.mart_occurrences_dashboard\r\n",
        "),\r\n",
        "collection_kpi AS (\r\n",
        "    SELECT\r\n",
        "        COUNT(DISTINCT collection_id) AS total_collections,\r\n",
        "        COUNT(DISTINCT CASE\r\n",
        "            WHEN UPPER(current_status) IN (\r\n",
        "                'COMPLETED',\r\n",
        "                'DONE',\r\n",
        "                'COLLECTED',\r\n",
        "                'CONCLUIDA',\r\n",
        "                'FINALIZADA',\r\n",
        "                'COLETADA'\r\n",
        "            )\r\n",
        "            THEN collection_id\r\n",
        "        END) AS completed_collections,\r\n",
        "        AVG(\r\n",
        "            CASE\r\n",
        "                WHEN completed_at IS NOT NULL\r\n",
        "                THEN resolution_time_hours\r\n",
        "            END\r\n",
        "        ) AS avg_resolution_hours\r\n",
        "    FROM volta_postgres.bi.mart_collection_performance\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    o.total_occurrences,\r\n",
        "    o.total_estimated_quantity_kg,\r\n",
        "    c.total_collections,\r\n",
        "    c.completed_collections,\r\n",
        "    ROUND(\r\n",
        "        100.0 * c.completed_collections / NULLIF(c.total_collections, 0),\r\n",
        "        2\r\n",
        "    ) AS completion_rate_pct,\r\n",
        "    ROUND(c.avg_resolution_hours, 2) AS avg_resolution_hours\r\n",
        "FROM occurrence_kpi o\r\n",
        "CROSS JOIN collection_kpi c;"
      ]
    },
    {
      "name": "dc779b54",
      "displayName": "ds_1907_mapa_cooperativas",
      "queryLines": [
        "SELECT\r\n",
        "    co.name AS cooperative_name,\r\n",
        "    co.latitude,\r\n",
        "    co.longitude,\r\n",
        "    COUNT(DISTINCT c.incident_id) AS occurrence_count\r\n",
        "FROM volta_postgres.public.collection c\r\n",
        "JOIN volta_postgres.public.incident i\r\n",
        "    ON i.id = c.incident_id\r\n",
        "JOIN volta_postgres.public.cooperative co\r\n",
        "    ON co.id = c.cooperative_id\r\n",
        "GROUP BY\r\n",
        "    co.name,\r\n",
        "    co.latitude,\r\n",
        "    co.longitude\r\n",
        "ORDER BY occurrence_count DESC;"
      ]
    },
    {
      "name": "eb1d8122",
      "displayName": "ds_1906_ocorrencias_por_hora",
      "queryLines": [
        "SELECT\r\n",
        "    HOUR(from_utc_timestamp(registered_at, 'America/Sao_Paulo')) AS hour_of_day,\r\n",
        "    COUNT(*) AS occurrence_count\r\n",
        "FROM volta_postgres.public.incident\r\n",
        "GROUP BY HOUR(from_utc_timestamp(registered_at, 'America/Sao_Paulo'))\r\n",
        "ORDER BY hour_of_day;"
      ]
    },
    {
      "name": "843ec8b8",
      "displayName": "ds_1905_tempo_de_resolucao",
      "queryLines": [
        "WITH conclusoes AS (\r\n",
        "    SELECT\r\n",
        "        collection_id,\r\n",
        "        MIN(changed_at) AS completed_at\r\n",
        "    FROM volta_postgres.public.collection_status\r\n",
        "    WHERE UPPER(status) IN ('COMPLETED', 'CONCLUIDA', 'FINALIZADA')\r\n",
        "    GROUP BY collection_id\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    c.id AS collection_id,\r\n",
        "    c.requested_at,\r\n",
        "    x.completed_at,\r\n",
        "    ROUND(\r\n",
        "        (unix_timestamp(x.completed_at) -\r\n",
        "         unix_timestamp(c.requested_at)) / 3600.0,\r\n",
        "        2\r\n",
        "    ) AS resolution_hours\r\n",
        "FROM volta_postgres.public.collection c\r\n",
        "JOIN conclusoes x\r\n",
        "    ON x.collection_id = c.id\r\n",
        "ORDER BY resolution_hours;"
      ]
    },
    {
      "name": "b3aa451e",
      "displayName": "ds_1904_evolucao_temporal",
      "queryLines": [
        "SELECT\r\n",
        "    to_date(\r\n",
        "        from_utc_timestamp(registered_at, 'America/Sao_Paulo')\r\n",
        "    ) AS date_key,\r\n",
        "    COUNT(DISTINCT id) AS occurrence_count\r\n",
        "FROM volta_postgres.public.incident\r\n",
        "GROUP BY\r\n",
        "    to_date(\r\n",
        "        from_utc_timestamp(registered_at, 'America/Sao_Paulo')\r\n",
        "    )\r\n",
        "ORDER BY date_key;"
      ]
    },
    {
      "name": "ca358c6f",
      "displayName": "ds_1903_ocorrencias_por_setor",
      "queryLines": [
        "SELECT\r\n",
        "    a.sector_name,\r\n",
        "    COUNT(*) AS occurrence_count\r\n",
        "FROM volta_postgres.public.incident i\r\n",
        "JOIN volta_postgres.public.area a\r\n",
        "    ON a.id = i.area_id\r\n",
        "GROUP BY a.sector_name\r\n",
        "ORDER BY occurrence_count DESC;"
      ]
    },
    {
      "name": "59f8f17b",
      "displayName": "operational_kpis",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.operational_kpis",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Representa o número total de linhas no conjunto de dados. Use essa medida para contar todos",
            "displayName": "Contagem"
          },
          {
            "name": "taxa_conclusao_pct",
            "expr": "100.0 * SUM(source.completed_collections)\r\n      / NULLIF(SUM(source.total_collections), 0)",
            "displayName": "Taxa de conclusão (%)"
          },
          {
            "name": "resolution_hours_summ",
            "expr": "SUM(source.resolution_hours_sum)\r\n  / NULLIF(SUM(source.resolved_collections_count), 0)",
            "displayName": "Horas de resolucao"
          }
        ]
      }
    }
  ],
