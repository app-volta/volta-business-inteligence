    {
      "name": "59f8f17b",
      "displayName": "operational_kpis",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.operational_kpis",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Representa o número total de linhas no conjunto de dados. Use essa medida para contar todos",
            "displayName": "Contagem"
          },
          {
            "name": "taxa_conclusao_pct",
            "expr": "100.0 * SUM(source.completed_collections)\r\n      / NULLIF(SUM(source.total_collections), 0)",
            "displayName": "Taxa de conclusão (%)"
          },
          {
            "name": "resolution_hours_summ",
            "expr": "SUM(source.resolution_hours_sum)\r\n  / NULLIF(SUM(source.resolved_collections_count), 0)",
            "displayName": "Horas de resolucao"
          }
        ]
      }
    },
